# Living Energy UI — 環境変数テンプレート
# 使い方: コピーして `.env.local` を作成する
#   cp .env.example .env.local
#   copy .env.example .env.local   (Windows)

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Living Energy UI

# mock: `features/*/data.ts` の静的デモ（現行プロトタイプ）
# live: Open-Meteo / FastAPI 接続時（未実装。live にしても現状は mock にフォールバック）
NEXT_PUBLIC_DATA_SOURCE=mock

# 既定地点（山梨県北杜市）— 構造分析書の地域P2Xノードに対応
NEXT_PUBLIC_DEFAULT_REGION_ID=hokuto
NEXT_PUBLIC_DEFAULT_LAT=35.8044
NEXT_PUBLIC_DEFAULT_LNG=138.4239
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Tokyo

# --- Open-Meteo（無料・APIキー不要 / ノード: open-meteo-fastapi）---
NEXT_PUBLIC_OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# --- FastAPI 計算基盤（未実装。pvlib 発電推計を載せるとき）---
# NEXT_PUBLIC_ENERGY_API_URL=http://localhost:8000

# --- スマートプラグ IoT（未実装。SwitchBot / Tapo 等）---
# SWITCHBOT_TOKEN=
# SWITCHBOT_SECRET=
